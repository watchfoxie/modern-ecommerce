IMAGE_TAG=local
WEB_BIND_ADDRESS=127.0.0.1
DEBUG_BIND_ADDRESS=127.0.0.1
RABBITMQ_CONFIG_FILE=./rabbitmq.conf.example

SERVICE_REGISTRY_PORT=8761
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
CATEGORY_SERVICE_PORT=8083
PRODUCT_SERVICE_PORT=8084
CART_SERVICE_PORT=8085
ORDER_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087

AUTH_SERVICE_DB_NAME=modern_ecommerce_auth_service
USER_SERVICE_DB_NAME=modern_ecommerce_user_service
CATEGORY_SERVICE_DB_NAME=modern_ecommerce_category_service
PRODUCT_SERVICE_DB_NAME=modern_ecommerce_product_service
CART_SERVICE_DB_NAME=modern_ecommerce_cart_service
ORDER_SERVICE_DB_NAME=modern_ecommerce_order_service
COMMON_COLLECTION_NAME=init
APP_DATA_MIGRATIONS_ENABLED=true
APP_DATA_MIGRATIONS_FAIL_FAST=true
APP_DATA_SEED_ENABLED=false
CATEGORY_SAMPLE_DATA_PATH=/app/static/sample-data/structured-data/category-service.categories.json
PRODUCT_SAMPLE_DATA_PATH=/app/static/sample-data/structured-data/product-service.products.json

AUTH_SERVICE_USERNAME=replace-with-auth-service-username
AUTH_SERVICE_PASSWORD=replace-with-auth-service-password
USER_SERVICE_USERNAME=replace-with-user-service-username
USER_SERVICE_PASSWORD=replace-with-user-service-password
CATEGORY_SERVICE_USERNAME=replace-with-category-service-username
CATEGORY_SERVICE_PASSWORD=replace-with-category-service-password
PRODUCT_SERVICE_USERNAME=replace-with-product-service-username
PRODUCT_SERVICE_PASSWORD=replace-with-product-service-password
CART_SERVICE_USERNAME=replace-with-cart-service-username
CART_SERVICE_PASSWORD=replace-with-cart-service-password

EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
# Optional: override the hostname or IP advertised in Eureka on multi-homed hosts.
# EUREKA_INSTANCE_HOSTNAME=workstation.internal
# EUREKA_INSTANCE_IP_ADDRESS=192.168.1.10
# EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
SPRING_CLOUD_INETUTILS_USE_ONLY_SITE_LOCAL_INTERFACES=true
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
API_GATEWAY_CONNECT_TIMEOUT=5000
API_GATEWAY_RESPONSE_TIMEOUT=5s
API_GATEWAY_RATE_LIMIT_PER_MINUTE=120
# Secrets must be injected from .env.local, CI/CD variables, Kubernetes Secret, or a secret manager.
JWT_SIGNING_SECRET=replace-with-local-jwt-signing-secret-minimum-32-characters
INTERNAL_SERVICE_TOKEN=replace-with-local-internal-service-token-minimum-32-characters
SPRING_PROFILES_ACTIVE=local
APP_VERSION=0.0.1-SNAPSHOT

NOTIFICATION_MAIL_CONNECTION_TIMEOUT=5000
NOTIFICATION_MAIL_TIMEOUT=5000
NOTIFICATION_MAIL_WRITE_TIMEOUT=5000
NOTIFICATION_MAIL_USERNAME=
NOTIFICATION_MAIL_PASSWORD=
NOTIFICATION_MAIL_ENABLED=false

AUTH_MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_and_identifier>.mongodb.net/<db_name>?appName=<uri_app_name>
USER_MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_and_identifier>.mongodb.net/<db_name>?appName=<uri_app_name>
CATEGORY_MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_and_identifier>.mongodb.net/<db_name>?appName=<uri_app_name>
PRODUCT_MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_and_identifier>.mongodb.net/<db_name>?appName=<uri_app_name>
CART_MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_and_identifier>.mongodb.net/<db_name>?appName=<uri_app_name>
ORDER_MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_and_identifier>.mongodb.net/<db_name>?appName=<uri_app_name>

AWS_ACCOUNT_ID=
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ECR_REGISTRY=
AWS_ECR_REPOSITORY_PREFIX=
AWS_SECRETS_MANAGER_PREFIX=
AWS_TERRAFORM_STATE_BUCKET=
AWS_TERRAFORM_STATE_KEY=
AWS_TERRAFORM_LOCK_TABLE=
AWS_TERRAFORM_STATE_KMS_KEY_ARN=

EKS_CLUSTER_NAME=
EKS_KUBERNETES_VERSION=
EKS_REGION=
EKS_CLUSTER_OPENID_CONNECT_PROVIDER_URL=
EKS_CLUSTER_IAM_ROLE_ARN=
EKS_CLUSTER_ARN=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=replace-with-rabbitmq-username
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_LISTENER_RETRY_MAX_ATTEMPTS=3
RABBITMQ_LISTENER_RETRY_INITIAL_INTERVAL=1000
RABBITMQ_LISTENER_RETRY_MAX_INTERVAL=10000
RABBITMQ_LISTENER_RETRY_MULTIPLIER=2.0
ORDER_EVENTS_EXCHANGE=modern-ecommerce.events
ORDER_EVENTS_DLX=modern-ecommerce.events.dlx
ORDER_CREATED_ROUTING_KEY=order.created
ORDER_CREATED_QUEUE=notification.order-created.v1
ORDER_CREATED_DLQ_QUEUE=notification.order-created.v1.dlq
ORDER_CREATED_DLQ_ROUTING_KEY=notification.order-created.v1.dlq

VITE_PORT=5173
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080
