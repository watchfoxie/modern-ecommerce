{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-ecommerce.local/schemas/order-service.orders.schema.json",
  "title": "order-service orders document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_id",
    "userId",
    "orderNumber",
    "items",
    "deliveryAddress",
    "payment",
    "status",
    "totalAmount",
    "currency",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "_id": { "$ref": "#/$defs/objectId" },
    "userId": { "$ref": "#/$defs/objectId" },
    "customerEmail": { "type": ["string", "null"], "format": "email" },
    "orderNumber": { "type": "string", "minLength": 6 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/orderItem" }
    },
    "deliveryAddress": { "$ref": "#/$defs/deliveryAddress" },
    "payment": { "$ref": "#/$defs/payment" },
    "status": {
      "type": "string",
      "enum": ["PENDING", "CONFIRMED", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"]
    },
    "totalAmount": { "$ref": "#/$defs/money" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "notes": { "type": ["string", "null"] },
    "createdAt": { "$ref": "#/$defs/date" },
    "updatedAt": { "$ref": "#/$defs/date" }
  },
  "$defs": {
    "objectId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$oid"],
      "properties": {
        "$oid": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" }
      }
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$date"],
      "properties": {
        "$date": { "type": "string", "format": "date-time" }
      }
    },
    "money": {
      "anyOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$numberDecimal"],
          "properties": {
            "$numberDecimal": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" }
          }
        }
      ]
    },
    "orderItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "name", "brand", "imageUrl", "quantity", "unitPrice"],
      "properties": {
        "productId": { "$ref": "#/$defs/objectId" },
        "name": { "type": "string", "minLength": 1 },
        "brand": { "type": "string", "minLength": 1 },
        "imageUrl": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 },
        "unitPrice": { "$ref": "#/$defs/money" }
      }
    },
    "deliveryAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "city", "district", "postalCode", "recipientName", "recipientPhone"],
      "properties": {
        "street": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "district": { "type": "string", "minLength": 1 },
        "postalCode": { "type": "string", "minLength": 1 },
        "recipientName": { "type": "string", "minLength": 1 },
        "recipientPhone": { "type": "string", "minLength": 1 }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "transactionId": { "type": ["string", "null"] }
      }
    }
  }
}
