{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://modern-ecommerce.local/schemas/cart-service._schema_migations.schema.json",
    "title": "cart-service _schema_migations document",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "_id",
        "version",
        "description",
        "checksum",
        "appliedAt"
    ],
    "properties": {
        "_id": {
            "$ref": "#/$defs/objectId"
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "checksum": {
            "type": "string",
            "minLength": 1
        },
        "appliedAt": {
            "$ref": "#/$defs/date"
        }
    },
    "$defs": {
        "objectId": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "$oid"
            ],
            "properties": {
                "$oid": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{24}$"
                }
            }
        },
        "date": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "$date"
            ],
            "properties": {
                "$date": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        }
    }
}