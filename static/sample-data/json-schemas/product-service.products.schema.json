{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-ecommerce.local/schemas/product-service.products.schema.json",
  "title": "product-service products document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_id",
    "categoryId",
    "categorySlug",
    "name",
    "slug",
    "brand",
    "model",
    "country",
    "price",
    "currency",
    "stock",
    "imageUrls",
    "specs",
    "isActive",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "_id": { "$ref": "#/$defs/objectId" },
    "categoryId": { "$ref": "#/$defs/objectId" },
    "categorySlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "brand": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "minLength": 1 },
    "price": { "$ref": "#/$defs/money" },
    "promotionalPrice": { "anyOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "stock": { "type": "integer", "minimum": 0 },
    "imageUrls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "specs": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "screenSize": { "type": "string" },
        "processor": { "type": "string" },
        "ram": { "type": "string" },
        "storage": { "type": "string" },
        "os": { "type": "string" },
        "battery": { "type": "string" },
        "camera": { "type": "string" },
        "gpu": { "type": "string" },
        "batteryLife": { "type": "string" }
      }
    },
    "isActive": { "type": "boolean" },
    "createdAt": { "$ref": "#/$defs/date" },
    "updatedAt": { "$ref": "#/$defs/date" }
  },
  "$defs": {
    "objectId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$oid"],
      "properties": {
        "$oid": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" }
      }
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$date"],
      "properties": {
        "$date": { "type": "string", "format": "date-time" }
      }
    },
    "money": {
      "anyOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$numberDecimal"],
          "properties": {
            "$numberDecimal": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" }
          }
        }
      ]
    }
  }
}
